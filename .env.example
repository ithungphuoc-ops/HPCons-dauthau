# ===== Firebase Admin — project RIÊNG của app này ("hpcons-dauthau") =====
# 3 trường tách rời của service account (Firebase Console → Project Settings →
# Service accounts → Generate new private key), KHÔNG gộp thành 1 khối JSON.
# Dùng để mint Custom Token và ghi hồ sơ nhân sự khi đăng nhập qua SSO.
FIREBASE_ADMIN_PROJECT_ID="hpcons-dauthau"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@hpcons-dauthau.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ===== Firebase Admin — project của App Tổng ("hpcons-portal") =====
# Nguyên khối JSON service account (khác project với 3 biến trên) — dùng để xác minh
# cookie phiên đăng nhập `session` của account.hpcore.vn.
HPCORE_FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"hpcons-portal",...}'

# ===== Bản thử (chỉ dùng khi phát triển trên máy cá nhân) =====
# = 1  → bỏ qua đăng nhập SSO App Tổng và KHÔNG kết nối Firestore; app hiện màn chọn
#        vai trò, dữ liệu chỉ nằm trong localStorage của máy đang chạy.
# Dùng để nghiệm thu tính năng khi chưa deploy được lên tên miền con dauthau.hpcore.vn
# (cookie phiên `session` của hpcore.vn không gửi tới localhost nên không đăng nhập được).
# AN TOÀN: cờ này bị vô hiệu hoá trong bản build production — điều kiện
# process.env.NODE_ENV !== 'production' trong src/App.tsx (hằng DEV_SANDBOX).
# ĐỪNG đặt biến này trên môi trường production.
NEXT_PUBLIC_DEV_SANDBOX=0

# ===== Thử-cloud (chỉ dùng khi cần nghiệm thu phần ĐỒNG BỘ FIRESTORE trên máy cá nhân) =====
# = 1  → bỏ qua SSO như Bản thử, NHƯNG VẪN đọc/ghi Firestore (đăng nhập ẨN DANH).
# Dùng để nghiệm thu những thứ Bản thử không chạm tới được: Sao lưu / Khôi phục có đẩy lên
# cloud, đồng bộ realtime giữa 2 máy.
#
# BẮT BUỘC trước khi bật:
#   1. Đổi khối config trong src/lib/firebase.ts sang project Firebase THỬ (không phải
#      "hpcons-dauthau"). Cờ này TỰ TẮT nếu vẫn đang trỏ project thật — app hiện thông báo
#      chặn thay vì ghi/xóa lên dữ liệu thật của Phòng.
#   2. Firebase Console của project thử → Authentication → Sign-in method → bật "Anonymous".
#   3. Firestore Rules của project thử cho phép người đã đăng nhập đọc/ghi.
#
# Đặt NEXT_PUBLIC_DEV_SANDBOX=0 khi dùng cờ này (Bản thử được kiểm trước và sẽ thắng).
# ĐỪNG đặt biến này trên môi trường production.
NEXT_PUBLIC_DEV_CLOUD_TEST=0

# ===== BẢN DEMO TRÊN WEB (deploy cho người khác xem thử — KHÔNG phải bản thật) =====
# = 1  → bỏ qua đăng nhập SSO và hiện màn chọn vai trò NGAY TRÊN BẢN DEPLOY.
# Vì sao cần: app thật đăng nhập qua App Tổng, mà cookie phiên hpcore.vn chỉ gửi tới subdomain
# hpcore.vn — mở bản deploy ở tên miền khác (vd *.vercel.app) là quay vòng đăng nhập, không vào được.
#
# ⚠️ AI CÓ LINK CŨNG VÀO ĐƯỢC và sửa được dữ liệu. Vì vậy PHẢI kèm NEXT_PUBLIC_FIREBASE_CONFIG
#    trỏ sang project Firebase THỬ. Nếu không, app tự CHẶN (không cho vào) để dữ liệu thật của
#    Phòng ở project "hpcons-dauthau" không bị ai sửa.
# ĐỪNG đặt biến này trên bản production thật.
NEXT_PUBLIC_DEMO_WEB=0

# ===== Trỏ app sang project Firebase khác mà KHÔNG sửa code =====
# Không khai → app dùng config production nằm trong src/lib/firebase.ts (IT triển khai
# production KHÔNG cần khai biến này).
# Khai → dán JSON một dòng, dùng cho bản demo / môi trường thử:
# NEXT_PUBLIC_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}

# ===== Cloudflare R2 — kho ẢNH ĐÍNH KÈM (bổ sung 20/08/2026) =====
# BẮT BUỘC cho production. Ảnh báo cáo đã gửi báo giá (cửa Bước 2 → 3 và 3 → 4) nay lưu
# trên Cloudflare R2; Firestore chỉ còn giữ metadata (tên tệp, người tải lên, thời điểm).
# Thiếu nhóm biến này thì mục "Ảnh báo cáo" báo lỗi khi tải ảnh lên.
# Bucket RIÊNG của app: "hpcons-dauthau". Access Key dùng chung token "hpcore-app-r2"
# trên Cloudflare (scope theo từng bucket) — xin khóa thật trực tiếp từ Sếp.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="hpcons-dauthau"
R2_PUBLIC_BASE_URL="https://<tên-miền-public-của-bucket>"

# ===== Báo sự cố về nhật ký tập trung của App Tổng (bổ sung 17/08/2026) =====
# Dùng trong instrumentation.ts: app tự gửi báo cáo khi gặp crash / lỗi 500 về App Tổng.
# Secret DÙNG CHUNG cho toàn hệ sinh thái — lấy đúng giá trị mà các app con khác đang dùng.
# Thiếu biến này app vẫn chạy bình thường, chỉ là sự cố không được ghi nhận tập trung.
INCIDENT_LOG_SECRET=""

# ===== API tóm tắt số liệu cho Dashboard toàn cảnh App Tổng (bổ sung 23/08/2026) =====
# Bảo vệ route GET /api/summary. App Tổng gọi sang kèm header
#   Authorization: Bearer <giá trị này>      (hoặc  x-api-key: <giá trị này>)
# Route này KHÔNG dùng cookie SSO — thiếu biến thì mọi lượt gọi đều trả 401.
# Tự sinh một chuỗi ngẫu nhiên đủ dài rồi khai GIỐNG NHAU ở cả hai phía (app này và App Tổng).
HPCONS_PORTAL_API_KEY=""

# ===== NỐI APP THÔNG TIN DỰ ÁN (bổ sung 15/09/2026) =====
# Dùng cho ô "Mã dự án" ở màn Đăng ký Dự án: bấm chọn mã là app tự điền sẵn tên dự án, chủ đầu tư,
# địa chỉ, quốc tịch CĐT, hình thức xây dựng, hồ sơ mời thầu, diện tích đất — và "sổ" ra tiến độ
# thiết kế của dự án đó.
# Các trường điền sẵn chỉ là GỢI Ý, người nhập vẫn sửa tay được; hồ sơ lưu theo đúng thứ họ nhập.
#
# KHÔNG khai hai biến này thì app VẪN CHẠY BÌNH THƯỜNG: ô mã dự án gõ tay như trước, và khi bấm
# nút chọn thì hiện dòng nhắc "chưa nối App Thông tin dự án, vui lòng nhập tay".
#
# Endpoint bên App Thông tin dự án cần trả JSON mảng (hoặc {data:[...]}) — danh sách khoá app này
# đọc được nằm ở đầu file app/api/du-an-tong/route.ts. Tên khoá bên đó khác thì sửa hàm chuanHoa()
# trong chính file ấy, chỉ một chỗ.
DU_AN_TONG_API_URL=""
DU_AN_TONG_API_KEY=""

# ============================================================================
# WEBHOOK NHẬN DỮ LIỆU TỪ APP KHÁC (IT chốt 15/09/2026 — "nối webhook vào đó")
# ============================================================================
# Thứ tự liên kết chị Trâm chốt:
#   App Thông tin dự án  → đẩy MÃ DỰ ÁN + thông tin dự án sang
#   → bấm vào mã đó       → xổ TIẾN ĐỘ THIẾT KẾ do App Thiết kế đẩy sang
# Hai app ghép với nhau BẰNG MÃ DỰ ÁN.
#
# App bên kia đẩy sang bằng:
#   POST https://<app-dau-thau>/api/webhook/du-an-tong
#   POST https://<app-dau-thau>/api/webhook/tien-do-thiet-ke
#   Header: Authorization: Bearer <secret tương ứng bên dưới>
#   Body  : { "items": [ ... ] }   (mẫu payload nằm ngay đầu mỗi file route)
#
# CHƯA khai secret thì webhook TỪ CHỐI mọi request (HTTP 503) — CỐ Ý. Một cửa nhận mở toang trong
# lúc chờ cấu hình là chỗ để người ngoài ghi đè danh mục dự án của công ty.
#
# Sinh secret ngẫu nhiên (chạy máy nào cũng được):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mỗi app một secret riêng, KHÔNG dùng chung: lộ một cái thì khoá một cái, không phải khoá cả hai.
#
# Kiểm tra đã cắm đúng địa chỉ chưa (không cần secret, không lộ dữ liệu):
#   GET https://<app-dau-thau>/api/webhook/tien-do-thiet-ke
#   → { ok: true, daCauHinhSecret: true/false }
DU_AN_TONG_WEBHOOK_SECRET=""
THIET_KE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# (TUỲ CHỌN) KÉO TRỰC TIẾP TIẾN ĐỘ THIẾT KẾ
# ---------------------------------------------------------------------------
# Chỉ dùng khi webhook CHƯA từng đẩy lần nào — để ngày đầu nối app không phải ngồi chờ lần đẩy kế
# tiếp. Đã có dữ liệu webhook thì app luôn ưu tiên dữ liệu webhook, hai biến này bị bỏ qua.
# Không khai cũng chạy bình thường: bảng tiến độ thiết kế hiện dòng nhắc "chưa nhận được dữ liệu".
THIET_KE_API_URL=""
THIET_KE_API_KEY=""

# ============================================================================
# LIÊN KẾT HAI CHIỀU VỚI APP THIẾT KẾ — KÝ HMAC (OpenSpec `lien-ket-thiet-ke-dau-thau`, 26/09/2026)
# ============================================================================
# Khác cổng Bearer ở trên: cặp Đấu thầu ↔ Thiết kế ký HMAC-SHA256 trên thân gói tin, đúng cơ chế
# App Thiết kế đang chạy với Phòng Kinh doanh (header x-webhook-signature + x-webhook-timestamp).
#
# WEBHOOK_SECRET_DT_PTK — MỘT secret cho cặp app, dùng CẢ HAI CHIỀU, khai GIỐNG HỆT ở App Thiết kế:
#   · Chiều 2 (gửi đi): ký sự kiện du_an.cap_nhat gửi sang App Thiết kế.
#   · Chiều 1 (nhận về): kiểm chữ ký ở POST /api/webhook/tien-do-thiet-ke-chi-tiet.
#     Chưa khai → cổng nhận trả 503 (cố ý). Kiểm: GET cùng địa chỉ → { daCauHinhSecret }.
#   Sinh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# THIET_KE_WEBHOOK_URL — cổng nhận bên App Thiết kế, vd https://tk.hpcore.vn/api/webhooks/incoming
#   Thiếu biến này (hoặc thiếu secret) thì chiều gửi trả "chưa cấu hình", KHÔNG làm hỏng việc lưu
#   dự án. Gỡ biến này là đường lùi khẩn cấp để tắt chiều gửi.
#   ⚠ Chỉ khai SAU KHI App Thiết kế đã deploy cổng nhận đã sửa (nhận externalId dạng chuỗi).
WEBHOOK_SECRET_DT_PTK=
THIET_KE_WEBHOOK_URL=
